// A-Z Jewelry & Swap store on Cloudflare. Built and run by GALOR WebWorks.
// tools/setup.mjs creates the database and photo bucket and fills in database_id.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "az-jewelry-store",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "../public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "az-jewelry-store", "database_id": "REPLACE_WITH_D1_ID" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "az-jewelry-store-media" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "AZ_PUBLIC_URL": "https://azpawn.galorweb.works" },
  "observability": { "enabled": true }
}
